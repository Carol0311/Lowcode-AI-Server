{
  "name": "my-express",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "type": "commonjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "start": "ts-node --transpile-only src/index.ts",
    "db:reset": "ts-node --transpile-only scripts/resetModuleDb.ts",
    "db:reset:all": "npm run db:reset",
    "db:reset:ai": "npm run db:reset -- ai",
    "db:reset:pages": "npm run db:reset -- pages",
    "db:reset:tables": "npm run db:reset -- tables",
    "db:reset:system": "npm run db:reset -- system",
    "db:test": "ts-node --transpile-only scripts/testDb.ts",
    "db:seed:categories": "npx knex seed:run --specific=01_Product_Categories.ts --knexfile src/db/knexfile.ts",
    "db:seed:system": "npx knex seed:run --specific=02_System.ts --knexfile src/db/knexfile.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@node-rs/jieba": "^2.0.1",
    "axios": "^1.13.2",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "express": "^4.22.1",
    "knex": "^3.1.0",
    "openai": "^6.16.0",
    "prettier": "^3.7.4",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
